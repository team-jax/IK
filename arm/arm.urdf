<?xml version="1.0"?>
<!--
  7-DOF single-arm kinematic model matching the hardware spec in CLAUDE.md section 2/4:
    shoulder_pitch, shoulder_roll  -> AK45 x2 (어깨 앞뒤/펼침)
    elbow                          -> AK45 x1 (팔꿈치)
    upper_arm_roll                -> MG996R x1 (상완 회전)
    wrist_yaw, wrist_pitch, wrist_roll -> MG996R x3 (손목 3축)
  Used by arm/ik.py via ikpy for inverse kinematics. Link lengths are placeholders
  until real arm dimensions are finalized by the 기구 설계 team.
-->
<robot name="upper_arm">

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>
  <material name="orange">
    <color rgba="0.9 0.5 0.1 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="shoulder_pitch_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="3"/>
  </joint>

  <link name="shoulder_roll_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="shoulder_roll" type="revolute">
    <parent link="shoulder_pitch_link"/>
    <child link="shoulder_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.2" upper="1.8" effort="10" velocity="3"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.30"/></geometry>
      <material name="grey"/>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  <joint name="upper_arm_roll" type="revolute">
    <parent link="shoulder_roll_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="3"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.25"/></geometry>
      <material name="grey"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 -0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4435" effort="10" velocity="3"/>
  </joint>

  <link name="wrist_yaw_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="wrist_yaw" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_yaw_link"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="5" velocity="3"/>
  </joint>

  <link name="wrist_pitch_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="wrist_pitch" type="revolute">
    <parent link="wrist_yaw_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5" velocity="3"/>
  </joint>

  <link name="wrist_roll_link">
    <visual>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.12"/></geometry>
      <material name="orange"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="5" velocity="3"/>
  </joint>

  <link name="end_effector_link"/>
  <joint name="end_effector_fixed" type="fixed">
    <parent link="wrist_roll_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
  </joint>

</robot>
