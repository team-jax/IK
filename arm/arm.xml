<mujoco model="upper_arm">
  <!--
    Grasping simulation scene. The 7 arm joints mirror arm/arm.urdf (same joint order, axes,
    and link lengths) so joint angles solved by ikpy map 1:1 onto qpos[0:7] — see arm/ik.py.
    On top of that mirror this file adds what the URDF deliberately omits: a 3-finger gripper
    (6 hinge joints, qpos[7:13]), a graspable cube on a pedestal (freejoint, qpos[13:20]),
    contact bitmasks, and 13 position actuators driven by mujoco_receiver.py.
    If arm.urdf changes, only the arm subtree here must be kept in sync.
  -->
  <compiler angle="radian"/>
  <!-- implicitfast integrates actuator/damping terms implicitly, decoupling the position-servo
       stiffness (kp) from timestep stability limits. -->
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.2" frictionloss="0.05"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" diffuse="1 1 1"/>
    <!--
      Collision bitmasks (default is contype=0 conaffinity=0 — arm links never collide):
        fingers:                contype=2 conaffinity=1
        object/pedestal/floor:  contype=1 conaffinity=3
      finger↔finger (2&1)|(2&1)=0 excluded (tips meet at the centerline at full curl and must
      not fight each other); finger↔object/pedestal 2&3≠0 and object↔pedestal/floor 1&3≠0 active.
    -->
    <geom name="floor" type="plane" size="1 1 0.1" contype="1" conaffinity="3" rgba="0.8 0.8 0.8 1"/>
    <geom name="target" type="sphere" size="0.02" pos="0.3 0.2 0.5" rgba="1 0 0 0.6" contype="0" conaffinity="0"/>

    <!-- Pedestal top at z=0.45: the receiver's height mapping bottoms out at BASE_Z=0.40
         (gripper_base), fingertips reach 0.06 lower, so the gripper can descend around a cube
         resting at center z=0.465. See .omc/plans/autopilot-impl.md for the geometry budget. -->
    <geom name="pedestal" type="box" pos="0.12 0 0.225" size="0.04 0.04 0.225"
          contype="1" conaffinity="3" rgba="0.5 0.4 0.3 1"/>

    <body name="base_link" pos="0 0 0.8">
      <geom type="sphere" size="0.03" rgba="0.3 0.3 0.3 1"/>

      <body name="shoulder_pitch_link">
        <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-1.5708 1.5708"/>
        <geom type="sphere" size="0.02" rgba="0.3 0.3 0.3 1"/>

        <body name="shoulder_roll_link">
          <joint name="shoulder_roll" type="hinge" axis="1 0 0" range="-0.2 1.8"/>
          <geom type="sphere" size="0.02" rgba="0.3 0.3 0.3 1"/>

          <body name="upper_arm_link">
            <joint name="upper_arm_roll" type="hinge" axis="0 0 1" range="-3.1416 3.1416"/>
            <geom type="cylinder" size="0.025 0.15" pos="0 0 -0.15" rgba="0.6 0.6 0.6 1"/>

            <body name="forearm_link" pos="0 0 -0.30">
              <joint name="elbow" type="hinge" axis="0 1 0" range="0 2.4435"/>
              <geom type="cylinder" size="0.02 0.125" pos="0 0 -0.125" rgba="0.6 0.6 0.6 1"/>

              <body name="wrist_yaw_link" pos="0 0 -0.25">
                <joint name="wrist_yaw" type="hinge" axis="0 0 1" range="-1.5708 1.5708"/>
                <geom type="sphere" size="0.015" rgba="0.3 0.3 0.3 1"/>

                <body name="wrist_pitch_link">
                  <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-1.5708 1.5708"/>
                  <geom type="sphere" size="0.015" rgba="0.3 0.3 0.3 1"/>

                  <body name="wrist_roll_link">
                    <joint name="wrist_roll" type="hinge" axis="1 0 0" range="-3.1416 3.1416"/>
                    <geom type="cylinder" size="0.015 0.06" pos="0 0 -0.06" rgba="0.9 0.5 0.1 1"/>
                    <site name="end_effector" pos="0 0 -0.12" size="0.015" rgba="0 1 0 1"/>

                    <!--
                      3-finger gripper (CLAUDE.md §2: 손가락 3개 x 2관절, MG90S x6 + 회전 x1).
                      Contact-enabled add-on hanging off wrist_roll_link at the same offset as
                      end_effector; it does NOT touch arm.urdf or the ikpy chain, so arm IK is
                      unaffected. apply_pose() in arm/ik.py only writes qpos[:7], and these finger
                      joints occupy qpos[7:13] (later in tree order), so the two don't collide.
                      Each finger has 2 hinge joints sharing one tangential axis so it curls toward
                      the gripper's centerline as the joint angle increases (0 = open; closed is
                      MAX_CURL in mujoco_receiver.py, tuned so tips meet at the centerline).
                      Driven by mujoco_receiver.py via the position actuators below, from the
                      tracked hand's per-finger curl values.
                    -->
                    <body name="gripper_base" pos="0 0 -0.12">
                      <geom type="cylinder" size="0.018 0.008" rgba="0.2 0.2 0.2 1"/>

                      <body name="finger1_base" pos="0.025 0 0">
                        <joint name="finger1_joint1" type="hinge" axis="0 1 0" range="0 2.0"/>
                        <geom type="capsule" fromto="0 0 0  0 0 -0.035" size="0.006" contype="2" conaffinity="1" friction="1.0 0.02 0.001" condim="4" rgba="0.15 0.15 0.15 1"/>
                        <body name="finger1_distal" pos="0 0 -0.035">
                          <joint name="finger1_joint2" type="hinge" axis="0 1 0" range="0 1.4"/>
                          <geom type="capsule" fromto="0 0 0  0 0 -0.025" size="0.005" contype="2" conaffinity="1" friction="1.0 0.02 0.001" condim="4" rgba="0.15 0.15 0.15 1"/>
                        </body>
                      </body>

                      <body name="finger2_base" pos="-0.0125 0.021651 0">
                        <joint name="finger2_joint1" type="hinge" axis="-0.866025 -0.5 0" range="0 2.0"/>
                        <geom type="capsule" fromto="0 0 0  0 0 -0.035" size="0.006" contype="2" conaffinity="1" friction="1.0 0.02 0.001" condim="4" rgba="0.15 0.15 0.15 1"/>
                        <body name="finger2_distal" pos="0 0 -0.035">
                          <joint name="finger2_joint2" type="hinge" axis="-0.866025 -0.5 0" range="0 1.4"/>
                          <geom type="capsule" fromto="0 0 0  0 0 -0.025" size="0.005" contype="2" conaffinity="1" friction="1.0 0.02 0.001" condim="4" rgba="0.15 0.15 0.15 1"/>
                        </body>
                      </body>

                      <body name="finger3_base" pos="-0.0125 -0.021651 0">
                        <joint name="finger3_joint1" type="hinge" axis="0.866025 -0.5 0" range="0 2.0"/>
                        <geom type="capsule" fromto="0 0 0  0 0 -0.035" size="0.006" contype="2" conaffinity="1" friction="1.0 0.02 0.001" condim="4" rgba="0.15 0.15 0.15 1"/>
                        <body name="finger3_distal" pos="0 0 -0.035">
                          <joint name="finger3_joint2" type="hinge" axis="0.866025 -0.5 0" range="0 1.4"/>
                          <geom type="capsule" fromto="0 0 0  0 0 -0.025" size="0.005" contype="2" conaffinity="1" friction="1.0 0.02 0.001" condim="4" rgba="0.15 0.15 0.15 1"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <!-- Graspable cube. Defined AFTER the arm subtree so the arm's 13 hinge joints keep
         qpos[0:13] (arm/ik.py's apply_pose writes qpos[:7] unchanged) and the freejoint takes
         qpos[13:20]. Spawned exactly on the pedestal face (top 0.45 + half-size 0.015) so the
         first mj_step starts penetration-free. -->
    <body name="object" pos="0.12 0 0.465">
      <freejoint name="object_free"/>
      <geom name="object_geom" type="box" size="0.015 0.015 0.015" mass="0.05"
            friction="1.0 0.02 0.001" condim="4" contype="1" conaffinity="3"
            rgba="0.9 0.2 0.2 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Position servos replace the receiver's old direct qpos writes so hand-tracking targets
         and mj_step contact physics coexist. Gains sized against the default-density link
         masses (upper arm ≈0.59 kg, forearm ≈0.31 kg, finger capsules ≈5 g); implicitfast
         keeps the servo stiffness stable at timestep=0.002. -->
    <position name="shoulder_pitch_act" joint="shoulder_pitch" kp="100" kv="10" ctrlrange="-1.5708 1.5708"/>
    <position name="shoulder_roll_act" joint="shoulder_roll" kp="100" kv="10" ctrlrange="-0.2 1.8"/>
    <position name="upper_arm_roll_act" joint="upper_arm_roll" kp="100" kv="10" ctrlrange="-3.1416 3.1416"/>
    <position name="elbow_act" joint="elbow" kp="100" kv="10" ctrlrange="0 2.4435"/>
    <position name="wrist_yaw_act" joint="wrist_yaw" kp="100" kv="10" ctrlrange="-1.5708 1.5708"/>
    <position name="wrist_pitch_act" joint="wrist_pitch" kp="100" kv="10" ctrlrange="-1.5708 1.5708"/>
    <position name="wrist_roll_act" joint="wrist_roll" kp="100" kv="10" ctrlrange="-3.1416 3.1416"/>
    <position name="finger1_joint1_act" joint="finger1_joint1" kp="5" kv="0.5" ctrlrange="0 2.0"/>
    <position name="finger1_joint2_act" joint="finger1_joint2" kp="5" kv="0.5" ctrlrange="0 1.4"/>
    <position name="finger2_joint1_act" joint="finger2_joint1" kp="5" kv="0.5" ctrlrange="0 2.0"/>
    <position name="finger2_joint2_act" joint="finger2_joint2" kp="5" kv="0.5" ctrlrange="0 1.4"/>
    <position name="finger3_joint1_act" joint="finger3_joint1" kp="5" kv="0.5" ctrlrange="0 2.0"/>
    <position name="finger3_joint2_act" joint="finger3_joint2" kp="5" kv="0.5" ctrlrange="0 1.4"/>
  </actuator>
</mujoco>
